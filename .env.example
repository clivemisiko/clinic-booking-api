# Copy to .env for local development (docker-compose provides these automatically).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinic
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinic_test
CLINIC_TIMEZONE=Africa/Nairobi
SLOT_MINUTES=30
MIN_BOOKING_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=90
